[Unit]
Description=Seedsow paired input bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/seedsow-input
ExecStart=/usr/bin/python3 /opt/seedsow-input/pi/pi_bridge.py --config /etc/seedsow-input.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=mixed

[Install]
WantedBy=multi-user.target
